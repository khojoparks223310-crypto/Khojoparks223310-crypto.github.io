<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#123c73">

<title>Church Welfare Management System</title>

<style>
*{box-sizing:border-box}

body{
margin:0;
font-family:Arial,sans-serif;
background:#f3f6fa;
color:#18212b;
}

header{
background:linear-gradient(135deg,#123c73,#1769aa);
color:white;
padding:25px 15px;
}

header h1{
margin:0;
font-size:25px;
}

header p{
margin:7px 0 0;
opacity:.9;
}

.container{
max-width:1100px;
margin:auto;
padding:15px;
}

nav{
display:flex;
gap:8px;
overflow:auto;
background:white;
padding:10px;
border-radius:14px;
margin:15px 0;
box-shadow:0 2px 8px #00000012;
}

nav button{
border:0;
background:#edf2f7;
padding:11px 15px;
border-radius:10px;
white-space:nowrap;
font-weight:bold;
}

nav button.active,
.primary{
background:#1769aa!important;
color:white;
}

.page{
display:none;
}

.page.active{
display:block;
}

.cards{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(190px,1fr));
gap:12px;
}

.card,
.panel{
background:white;
border-radius:15px;
padding:18px;
box-shadow:0 2px 9px #00000012;
}

.panel{
margin-top:15px;
}

.card h3{
margin:0 0 8px;
font-size:14px;
color:#687585;
}

.big{
font-size:27px;
font-weight:bold;
}

.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
gap:12px;
}

label{
display:block;
font-weight:bold;
margin:10px 0 5px;
}

input,
select,
textarea{
width:100%;
padding:12px;
border:1px solid #ccd5df;
border-radius:9px;
font-size:15px;
}

textarea{
min-height:90px;
}

button{
border:0;
border-radius:9px;
padding:11px 14px;
font-weight:bold;
margin:5px 3px 0 0;
}

.danger{
background:#d9534f;
color:white;
}

table{
width:100%;
border-collapse:collapse;
margin-top:12px;
min-width:650px;
}

th,td{
padding:10px;
border-bottom:1px solid #e4e9ef;
text-align:left;
}

th{
background:#f5f7fa;
}

.table-wrap{
overflow:auto;
}

.search{
margin:10px 0;
}

.badge{
display:inline-block;
padding:5px 8px;
border-radius:20px;
background:#e8f2ff;
color:#1769aa;
font-size:12px;
font-weight:bold;
}

.empty{
padding:20px;
text-align:center;
color:#718096;
}

footer{
text-align:center;
color:#718096;
padding:25px 10px;
}
</style>
</head>

<body>

<header>
<div class="container">

<h1>⛪ Church Welfare Management System</h1>

<p>
Member Records • Contributions • Welfare Requests • Reports
</p>

</div>
</header>

<div class="container">

<nav>

<button class="tab active" data-page="dashboard">
Dashboard
</button>

<button class="tab" data-page="members">
Members
</button>

<button class="tab" data-page="contributions">
Contributions
</button>

<button class="tab" data-page="welfare">
Welfare
</button>

<button class="tab" data-page="reports">
Reports
</button>

</nav>


<!-- DASHBOARD -->

<section id="dashboard" class="page active">

<div class="cards">

<div class="card">
<h3>Total Members</h3>
<div class="big" id="statMembers">0</div>
</div>

<div class="card">
<h3>Total Contributions</h3>
<div class="big" id="statContributions">GH₵0.00</div>
</div>

<div class="card">
<h3>Welfare Paid</h3>
<div class="big" id="statPaid">GH₵0.00</div>
</div>

<div class="card">
<h3>Pending Requests</h3>
<div class="big" id="statPending">0</div>
</div>

</div>

<div class="panel">

<h2>Welcome</h2>

<p>
Welcome to the Church Welfare Management System.
</p>

<p>
This system allows church administrators to manage
members, welfare contributions and welfare requests.
</p>

<p>
<strong>Currency:</strong> Ghana Cedi (GH₵)
</p>

</div>

</section>


<!-- MEMBERS -->

<section id="members" class="page">

<div class="panel">

<h2>Add Church Member</h2>

<form id="memberForm">

<div class="grid">

<div>
<label>Full Name *</label>
<input id="mName" required>
</div>

<div>
<label>Phone Number</label>
<input id="mPhone" type="tel">
</div>

<div>
<label>Email</label>
<input id="mEmail" type="email">
</div>

<div>
<label>Department / Ministry</label>
<input id="mDept" placeholder="Youth, Choir, etc.">
</div>

<div>
<label>Status</label>

<select id="mStatus">
<option>Active</option>
<option>Inactive</option>
</select>

</div>

</div>

<button class="primary">
Add Member
</button>

</form>

</div>


<div class="panel">

<h2>Member List</h2>

<input
class="search"
id="memberSearch"
placeholder="Search members..."
>

<div class="table-wrap">

<table>

<thead>

<tr>
<th>Name</th>
<th>Phone</th>
<th>Department</th>
<th>Status</th>
<th>Action</th>
</tr>

</thead>

<tbody id="memberTable"></tbody>

</table>

</div>

</div>

</section>


<!-- CONTRIBUTIONS -->

<section id="contributions" class="page">

<div class="panel">

<h2>Record Welfare Contribution</h2>

<form id="contributionForm">

<div class="grid">

<div>

<label>Member *</label>

<select id="cMember" required>
<option value="">Select member</option>
</select>

</div>

<div>

<label>Amount (GH₵) *</label>

<input
id="cAmount"
type="number"
min="0"
step="0.01"
required
>

</div>

<div>

<label>Date *</label>

<input id="cDate" type="date" required>

</div>

<div>

<label>Reference / Note</label>

<input id="cNote">

</div>

</div>

<button class="primary">
Save Contribution
</button>

</form>

</div>


<div class="panel">

<h2>Contribution History</h2>

<div class="table-wrap">

<table>

<thead>

<tr>
<th>Date</th>
<th>Member</th>
<th>Amount</th>
<th>Note</th>
<th>Action</th>
</tr>

</thead>

<tbody id="contributionTable"></tbody>

</table>

</div>

</div>

</section>


<!-- WELFARE -->

<section id="welfare" class="page">

<div class="panel">

<h2>Welfare Request</h2>

<form id="welfareForm">

<div class="grid">

<div>

<label>Member *</label>

<select id="wMember" required>
<option value="">Select member</option>
</select>

</div>

<div>

<label>Request Type</label>

<select id="wType">

<option>Medical</option>
<option>Funeral</option>
<option>Marriage</option>
<option>Emergency</option>
<option>Other</option>

</select>

</div>

<div>

<label>Amount Requested (GH₵)</label>

<input
id="wAmount"
type="number"
min="0"
step="0.01"
>

</div>

<div>

<label>Date</label>

<input id="wDate" type="date" required>

</div>

</div>

<label>Reason / Details</label>

<textarea
id="wReason"
placeholder="Enter details of the welfare request..."
></textarea>

<button class="primary">
Submit Welfare Request
</button>

</form>

</div>


<div class="panel">

<h2>Welfare Requests</h2>

<div class="table-wrap">

<table>

<thead>

<tr>
<th>Date</th>
<th>Member</th>
<th>Type</th>
<th>Amount</th>
<th>Status</th>
<th>Action</th>
</tr>

</thead>

<tbody id="welfareTable"></tbody>

</table>

</div>

</div>

</section>


<!-- REPORTS -->

<section id="reports" class="page">

<div class="panel">

<h2>Reports & Backup</h2>

<p>
Export your church records as CSV files.
</p>

<button
class="primary"
onclick="exportMembers()"
>
Export Members
</button>

<button
class="primary"
onclick="exportContributions()"
>
Export Contributions
</button>

<button
class="primary"
onclick="exportWelfare()"
>
Export Welfare
</button>

<button
class="danger"
onclick="clearAllData()"
>
Delete All Data
</button>

</div>

<div class="panel">

<h2>Church Information</h2>

<p>
<strong>Church:</strong>
Global Christ Assembly Church
</p>

<p>
<strong>Currency:</strong>
Ghana Cedi (GH₵)
</p>

</div>

</section>


<footer>

Church Welfare Management System

</footer>

</div>


<script>

const KEY = "churchWelfareSystemV1";

let db = JSON.parse(
localStorage.getItem(KEY) ||
'{"members":[],"contributions":[],"welfare":[]}'
);


function save(){

localStorage.setItem(
KEY,
JSON.stringify(db)
);

renderAll();

}


function money(number){

return "GH₵" +
Number(number || 0).toFixed(2);

}


function today(){

return new Date()
.toISOString()
.slice(0,10);

}


function escapeHTML(text){

return String(text || "")
.replace(/[&<>"']/g,function(m){

return {
"&":"&amp;",
"<":"&lt;",
">":"&gt;",
'"':"&quot;",
"'":"&#039;"

}[m];

});

}


function memberName(id){

const member =
db.members.find(x => x.id === id);

return member
? member.name
: "Unknown Member";

}


/* NAVIGATION */

document
.querySelectorAll(".tab")
.forEach(button => {

button.onclick = function(){

document
.querySelectorAll(".tab")
.forEach(x =>
x.classList.remove("active")
);

document
.querySelectorAll(".page")
.forEach(x =>
x.classList.remove("active")
);

button.classList.add("active");

document
.getElementById(button.dataset.page)
.classList.add("active");

};

});


/* ADD MEMBER */

document
.getElementById("memberForm")
.onsubmit = function(e){

e.preventDefault();

db.members.push({

id:Date.now().toString(),

name:mName.value.trim(),

phone:mPhone.value.trim(),

email:mEmail.value.trim(),

dept:mDept.value.trim(),

status:mStatus.value

});

this.reset();

save();

alert("Member added successfully.");

};


/* ADD CONTRIBUTION */

document
.getElementById("contributionForm")
.onsubmit = function(e){

e.preventDefault();

db.contributions.push({

id:Date.now().toString(),

memberId:cMember.value,

amount:Number(cAmount.value),

date:cDate.value,

note:cNote.value.trim()

});

this.reset();

cDate.value=today();

save();

alert("Contribution saved successfully.");

};


/* WELFARE REQUEST */

document
.getElementById("welfareForm")
.onsubmit = function(e){

e.preventDefault();

db.welfare.push({

id:Date.now().toString(),

memberId:wMember.value,

type:wType.value,

amount:Number(wAmount.value || 0),

date:wDate.value,

reason:wReason.value.trim(),

status:"Pending"

});

this.reset();

wDate.value=today();

save();

alert("Welfare request submitted.");

};


/* MEMBER SEARCH */

document
.getElementById("memberSearch")
.oninput = renderMembers;


function renderMembers(){

const search =
memberSearch.value.toLowerCase();

const members =
db.members.filter(m =>

(m.name+" "+m.phone+" "+m.dept)
.toLowerCase()
.includes(search)

);

memberTable.innerHTML =
members.length

?

members.map(m => `

<tr>

<td>${escapeHTML(m.name)}</td>

<td>${escapeHTML(m.phone)}</td>

<td>${escapeHTML(m.dept)}</td>

<td>
<span class="badge">
${escapeHTML(m.status)}
</span>
</td>

<td>

<button
class="danger"
onclick="deleteMember('${m.id}')"
>
Delete
</button>

</td>

</tr>

`).join("")

:

`
<tr>
<td colspan="5" class="empty">
No members found.
</td>
</tr>
`;

}


/* MEMBER DROPDOWNS */

function renderSelects(){

const options =
'<option value="">Select member</option>' +

db.members.map(m => `

<option value="${m.id}">
${escapeHTML(m.name)}
</option>

`).join("");

cMember.innerHTML=options;

wMember.innerHTML=options;

}


/* CONTRIBUTIONS */

function renderContributions(){

contributionTable.innerHTML =

db.contributions.length

?

db.contributions
.slice()
.reverse()
.map(x => `

<tr>

<td>${x.date}</td>

<td>${escapeHTML(
memberName(x.memberId)
)}</td>

<td>${money(x.amount)}</td>

<td>${escapeHTML(x.note)}</td>

<td>

<button
class="danger"
onclick="deleteContribution('${x.id}')"
>
Delete
</button>

</td>

</tr>

`).join("")

:

`
<tr>
<td colspan="5" class="empty">
No contributions recorded.
</td>
</tr>
`;

}


/* WELFARE TABLE */

function renderWelfare(){

welfareTable.innerHTML =

db.welfare.length

?

db.welfare
.slice()
.reverse()
.map(x => `

<tr>

<td>${x.date}</td>

<td>${escapeHTML(
memberName(x.memberId)
)}</td>

<td>${escapeHTML(x.type)}</td>

<td>${money(x.amount)}</td>

<td>

<span class="badge">
${x.status}
</span>

</td>

<td>

${
x.status === "Pending"

?

`
<button
class="primary"
onclick="approveWelfare('${x.id}')"
>
Approve
</button>
`

:

""

}

<button
class="danger"
onclick="deleteWelfare('${x.id}')"
>
Delete
</button>

</td>

</tr>

`).join("")

:

`
<tr>
<td colspan="6" class="empty">
No welfare requests.
</td>
</tr>
`;

}


/* DASHBOARD */

function renderStats(){

statMembers.textContent =
db.members.length;

statContributions.textContent =
money(
db.contributions.reduce(
(total,x) =>
total + Number(x.amount || 0),
0
)
);

statPaid.textContent =
money(
db.welfare
.filter(x => x.status === "Approved")
.reduce(
(total,x) =>
total + Number(x.amount || 0),
0
)
);

statPending.textContent =
db.welfare.filter(
x => x.status === "Pending"
).length;

}


/* DELETE MEMBER */

function deleteMember(id){

if(
confirm("Delete this member?")
){

db.members =
db.members.filter(
x => x.id !== id
);

save();

}

}


/* DELETE CONTRIBUTION */

function deleteContribution(id){

if(
confirm("Delete this contribution?")
){

db.contributions =
db.contributions.filter(
x => x.id !== id
);

save();

}

}


/* DELETE WELFARE */

function deleteWelfare(id){

if(
confirm("Delete this welfare request?")
){

db.welfare =
db.welfare.filter(
x => x.id !== id
);

save();

}

}


/* APPROVE WELFARE */

function approveWelfare(id){

const request =
db.welfare.find(
x => x.id === id
);

if(request){

request.status="Approved";

save();

alert(
"Welfare request approved."
);

}

}


/* CSV EXPORT */

function csv(rows){

if(!rows.length)
return "";

const keys =
Object.keys(rows[0]);

return [

keys.join(","),

...rows.map(row =>

keys.map(key =>

`"${String(
row[key] ?? ""
).replace(/"/g,'""')}"`

).join(",")

)

].join("\n");

}


function download(filename,data){

const link =
document.createElement("a");

link.href =
URL.createObjectURL(
new Blob(
[data],
{type:"text/csv"}
)
);

link.download=filename;

link.click();

}


/* EXPORT MEMBERS */

function exportMembers(){

download(
"church-members.csv",
csv(db.members)
);

}


/* EXPORT CONTRIBUTIONS */

function exportContributions(){

download(
"church-contributions.csv",

csv(

db.contributions.map(x => ({

...x,

member:
memberName(x.memberId)

}))

)

);

}


/* EXPORT WELFARE */

function exportWelfare(){

download(
"church-welfare.csv",

csv(

db.welfare.map(x => ({

...x,

member:
memberName(x.memberId)

}))

);

}


/* DELETE EVERYTHING */

function clearAllData(){

if(
confirm(
"WARNING: This will delete all church records stored in this browser. Continue?"
)
){

db={
members:[],
contributions:[],
welfare:[]
};

save();

alert(
"All local data has been deleted."
);

}

}


/* START SYSTEM */

cDate.value=today();

wDate.value=today();

renderAll();

</script>

</body>
</html>